# Bundle Atlas's pinned/modified MCPs without duplicating their packaging.
ARG ATLAS_RUNTIME_IMAGE=mcp-atlas-runtime:mcphub
FROM ${ATLAS_RUNTIME_IMAGE}

COPY scripts/install_atlas_hub_extras.sh /tmp/install_atlas_hub_extras.sh
RUN sh /tmp/install_atlas_hub_extras.sh && rm /tmp/install_atlas_hub_extras.sh

WORKDIR /app
RUN npm install --global pnpm@10.12.4
COPY package.json pnpm-lock.yaml .pnpmfile.cjs ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build && rm /app/mcp_settings.json && chmod 0755 /app/entrypoint.sh

ENV MCPHUB_AUDIT_LOG_DIR=/app/data/tool-audit \
    MCP_USAGE_LOG_DIR=/app/data/mcp-usage \
    MCP_USAGE_LOG_STDERR=true
EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["node", "dist/index.js"]
