PORT=3000
NODE_ENV=development
# Optional sub-path for local development and reverse-proxy deployments.
# BASE_PATH=/mcphub
# DEFAULT_REQUEST_TIMEOUT=60000
# INIT_TIMEOUT=300000
# How many upstream servers may connect at once during startup.
# Unset or 0 connects them all in parallel, which is the previous behaviour.
# STARTUP_CONNECT_CONCURRENCY=0

# Rate limiting (all optional; the defaults below are applied when unset).
# Windows are in milliseconds. The login limiter counts failed attempts only, so
# API clients and service accounts that re-authenticate on token expiry are never
# locked out; the registration limiter counts every request, because a successful
# registration is what its cap exists to limit.
#
# Set any *_MAX to 0 (or "off") to remove that limit entirely. Note this is not
# passed through to express-rate-limit, where a limit of 0 rejects every request.
# Disabling a limiter logs a warning at startup; only do it where the deployment
# is protected by other means.
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# REGISTER_RATE_LIMIT_MAX=20
# REGISTER_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=600
# API_RATE_LIMIT_WINDOW_MS=900000
# MCP_RATE_LIMIT_MAX=480
# MCP_RATE_LIMIT_WINDOW_MS=60000
# TEMPLATE_RATE_LIMIT_MAX=200
# TEMPLATE_RATE_LIMIT_WINDOW_MS=900000
# SPA_RATE_LIMIT_MAX=600
# SPA_RATE_LIMIT_WINDOW_MS=60000
# HOSTED_EVENT_RATE_LIMIT_MAX=600
# HOSTED_EVENT_RATE_LIMIT_WINDOW_MS=60000

# Database Configuration (Optional - for database-backed configuration)
# Simply set DB_URL to enable database mode (auto-detected)
# DB_URL=postgresql://mcphub:password@localhost:5432/mcphub
# Or explicitly control with USE_DB (overrides auto-detection)
# USE_DB=true

# Root Compose deployment (MCPHub v2). Choose the database values before first start.
# USE_DB=true
# DB_URL=postgresql://mcphub_v2:YOUR_DATABASE_PASSWORD@db:5432/mcphub_v2
# POSTGRES_USER=mcphub_v2
# POSTGRES_DB=mcphub_v2
# POSTGRES_PASSWORD=
# MCPHUB_SETTING_PATH=/app/data/mcp_settings.json
# MCPHUB_V2_IMAGE=mcphub-v2:local
# MCPHUB_V2_BIND=0.0.0.0
# MCPHUB_V2_PORT=3003
# node deploy/v2/prepare-workers.mjs generates these control credentials in .env:
# MCPHUB_ATLAS_WORKER_TOKEN=
# MCPHUB_TOOLATHLON_WORKER_TOKEN=
# MCPHUB_WORKERS=
# MCPHUB_REQUIRE_WORKERS=true
# MCPHUB_INTERNAL_URL=http://hub:3000

# Better Auth (optional social login: GitHub / Google / local OIDC)
# Better Auth bootstrap config is read only at startup.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_ENABLED=true
# BETTER_AUTH_BASE_PATH=/api/auth/better
# BETTER_AUTH_TRUSTED_ORIGINS=https://dashboard.example.com,https://admin.example.com
# BETTER_AUTH_GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_GITHUB_ENABLED=true
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# BETTER_AUTH_OIDC_ENABLED=true
# BETTER_AUTH_OIDC_PROVIDER_ID=local-oidc
# BETTER_AUTH_OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
# BETTER_AUTH_OIDC_SCOPES=openid,profile,email
# BETTER_AUTH_OIDC_PKCE=true
# BETTER_AUTH_OIDC_PROMPT=login
# OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Forward auth (trust a JWKS-verified JWT from an upstream gateway; off by default)
# FORWARD_AUTH_ENABLED=true
# FORWARD_AUTH_MODE=jwks
# FORWARD_AUTH_JWKS_URI=https://idp.example.com/.well-known/jwks.json
# FORWARD_AUTH_ISSUER=https://idp.example.com/
# FORWARD_AUTH_AUDIENCE=mcphub
# FORWARD_AUTH_ALGORITHMS=RS256,ES256
# FORWARD_AUTH_USERNAME_CLAIM=preferred_username
# FORWARD_AUTH_EMAIL_CLAIM=email
# FORWARD_AUTH_AUTO_CREATE=true

# Hosted data-plane mode for hub.mcphub.app
# HUB_MODE=hosted
# HOSTED_CONTROL_PLANE_URL=https://mcphub.app
# Shared HMAC secret with mcphub.app /api/internal/v1/*
# INTERNAL_API_SECRET=replace-with-32-plus-random-bytes
# HOSTED_CONTROL_PLANE_TIMEOUT_MS=5000
# Multi-node hosted data plane
# HUB_CLUSTER_ID=prod-us-east-1
# HUB_NODE_ID=hub-1
# HUB_EVENT_REDIS_URL=redis://localhost:6379
# HUB_EVENT_CHANNEL=mcphub:hosted-events

# Metadata-only call audit; required for HTTP forwarding, optional for MCP calls.
# Preserve this directory using a persistent volume.
# MCPHUB_AUDIT_LOG_DIR=/app/data/tool-audit
# Persistent Yibu monthly/key/MCP usage rollups; defaults beside the audit directory.
# Keep this directory when archiving original logs. Never store it on ephemeral storage.
# MCPHUB_USAGE_STATS_DIR=/app/data/usage-statistics/yibu

# Built-in residential egress relay (Python 3, no Atlas installation needed).
# Start/stop it as an administrator on the Relay page. No automatic startup.
# Saved dashboard credentials override this initial token after a reset.
MCP_RELAY_TOKEN=
# Address reachable from every MCP/task worker; use the Hub host's LAN IP.
# Example: http://<hub-lan-ip>:3985
MCP_RELAY_URL=
MCP_RELAY_BIND=0.0.0.0
MCP_RELAY_PORT=3985
# v2 Compose host mapping (container Relay port remains 3985).
# MCPHUB_RELAY_PUBLISHED_BIND=0.0.0.0
# MCPHUB_RELAY_PUBLISHED_PORT=3985
MCP_RELAY_PYTHON=python3
# Persistent directory; Docker uses /app/data/relay/usage.jsonl.
MCP_RELAY_USAGE_LOG=./data/relay/usage.jsonl
# IPWO residential proxy account; never commit real credentials.
IPWO_PROXY_HOST=
IPWO_PROXY_PORT=
IPWO_PROXY_USERNAME=
IPWO_PROXY_PASSWORD=
IPWO_PROXY_COUNTRY=US
# Optional upstream request controls. Per-host limits remain editable in the UI.
# Queue, cooldown, retries and network share one total budget; keep below client timeout.
# Fallback for categories without dashboard overrides. See relay/README.md.
# MCP_RELAY_REQUEST_TIMEOUT_SECONDS=85
# MCP_RELAY_UPSTREAM_TIMEOUT_SECONDS=45
# Experimental arXiv network-timeout retry: no added backoff; FIFO/spacing still apply.
# MCP_RELAY_ARXIV_IMMEDIATE_TIMEOUT_RETRY=false
# MCP_RELAY_MAX_RESPONSE_BYTES=67108864
# MCP_RELAY_USER_AGENT=MCPHubRelay/1.0 (https://github.com/lilgong/mcphub)
# Overpass only: persistent successful responses; exact query matching across mirrors.
# Defaults to a SQLite file beside the Relay usage log (on the mounted data volume).
MCP_RELAY_OVERPASS_CACHE_ENABLED=true
# MCP_RELAY_OVERPASS_CACHE_PATH=/app/data/relay/overpass-cache.sqlite3
MCP_RELAY_OVERPASS_CACHE_DAYS=30
MCP_RELAY_OVERPASS_REFRESH_DAYS=7

# Optional upstream URL referenced as ${SERPER_UPSTREAM_URL} in a forwarding server.
# SERPER_UPSTREAM_URL=https://yibuapi.com/serper

# Optional namespaced STDIO execution workers. Public MCPs always stay in Hub.
# Generate private control tokens with node deploy/v2/prepare-workers.mjs.
# MCPHUB_WORKERS={"atlas":{"catalog":"atlas","url":"ws://atlas-worker:3100/stdio","token":"replace-with-a-random-control-token-at-least-32-characters"}}
# Fail closed instead of launching a namespaced STDIO MCP in Hub without a worker.
# MCPHUB_REQUIRE_WORKERS=true
# Reachable only from workers; used for their existing key-pool callback.
# MCPHUB_INTERNAL_URL=http://hub:3000

# Workspace HTTP read inactivity fallback in milliseconds when neither caller nor
# MCP configuration supplies a finite budget. Starts after queue admission.
MCPHUB_WORKSPACE_HTTP_TIMEOUT_MS=300000

# Optional persistent index root for ordinary tool-call statistics.
# Default: usage-statistics/tool beside MCPHUB_AUDIT_LOG_DIR.
# MCPHUB_TOOL_STATS_DIR=/app/data/usage-statistics/tool

# Public arXiv /api/query cache (Relay restart required). Errors are never stored.
MCP_RELAY_ARXIV_CACHE_ENABLED=true
# MCP_RELAY_ARXIV_CACHE_PATH=/app/data/relay/arxiv-query-cache.sqlite3
MCP_RELAY_ARXIV_CACHE_HOURS=24
